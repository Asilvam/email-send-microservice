# CTQ usa https://ctq.serviciosasm.cl desde 2026-10-29; el backend construye
# el enlace de recuperacion con PASSWORD_RESET_FRONTEND_URL en su propio entorno.
# Este servicio conserva el HTML/texto recibido y no necesita una variable de dominio.
PORT=3001
INTERNAL_API_KEY=generate-a-shared-internal-api-key
MAIL_HOST=smtp.example.com
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=notifications@example.com
MAIL_FROM_NAME=Email Notifications
MAIL_PORT=587
MAIL_SECURE=false
